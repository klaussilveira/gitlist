<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>{% block title %}{{ 'REPOSITORY_LIST_TITLE'|trans }}{% endblock %} &middot; {{ title }}</title>
    {% block stylesheets %}{% endblock %}
    <link rel="stylesheet" href="{{ asset('theme/scss/main.scss') }}">

    {% block javascripts %}{% endblock %}
    {{ importmap('theme/js/main.js') }}

    {% if default_blob_viewer == 'ace' %}
      <link rel="stylesheet" href="{{ asset('viewers/ace/main.css') }}">
      <script defer src="{{ asset('vendor/ace/ace.js') }}"></script>
      <script type="module" src="{{ asset('viewers/ace/main.js') }}"></script>
    {% elseif default_blob_viewer == 'codemirror' %}
      <link rel="stylesheet" href="{{ asset('vendor/codemirror/codemirror.css') }}">
      <link rel="stylesheet" href="{{ asset('viewers/codemirror/main.css') }}">
      <script defer src="{{ asset('vendor/codemirror/codemirror.js') }}"></script>
      <script defer src="{{ asset('vendor/codemirror/loadmode.js') }}"></script>
      <script type="module" src="{{ asset('viewers/codemirror/main.js') }}"></script>
    {% endif %}
  </head>
  <body>
    {% include 'icons.html.twig' %}
    <header>
      <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container d-flex">
          <a class="navbar-brand" href="{{ path('repository_list') }}"><svg class="icon"><use href="#i-git-compare"/></svg> {{ title }}</a>

          <ul class="navbar-nav">
            <li class="nav-item active">
              <a class="nav-link" href="{{ path('repository_list') }}">{{ 'REPOSITORY_LIST_TITLE'|trans }}</a>
            </li>
            {% for item in navigation %}
              <li class="nav-item">
                <a class="nav-link" href="{{ item.target }}">{{ item.label }}</a>
              </li>
            {% endfor %}
          </ul>

          {% block search %}
          {% endblock %}
        </div>
      </nav>
    </header>

    <div class="container mt-2">
      {% for label, messages in app.flashes() %}
        {% for message in messages %}
          <div class="alert alert-{{ label }}">
            {{ message }}
          </div>
        {% endfor %}
      {% endfor %}
    </div>

    {% block header %}{% endblock %}

    <div class="container">
    {% block body %}{% endblock %}
    </div>

    <footer class="d-flex justify-content-center">
      <p>&copy; 2012 - {{ 'now'|date('Y') }} Powered by <a href="https://gitlist.org">GitList.org</a></p>
    </footer>
  </body>
</html>
