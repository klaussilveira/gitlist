{% extends 'base.html.twig' %}

{% block title %}
  {{ 'REPOSITORY_COMPARE_TITLE'|trans }} {{ base }}...{{ head }} - {{ repository.name }}
{% endblock %}

{% block header %}
  {% include 'page-header.html.twig' with { repository: repository, baseRef: repository.defaultBranch, current: 'branches' } %}
{% endblock %}

{% block search %}
  {% include 'search.html.twig' with { repository: repository, commitish: head } %}
{% endblock %}

{% block body %}
<div class="row module-row">
  <div class="col-12">
    <form class="card" method="get" action="{{ path('repository_compare_form', { repository: repository.name }) }}">
      <div class="card-body">
        <div class="row g-2 align-items-end">
          {% for field in [{ name: 'base', value: base, label: 'REPOSITORY_COMPARE_BASE' }, { name: 'head', value: head, label: 'REPOSITORY_COMPARE_HEAD' }] %}
            <div class="col-12 col-md">
              <label class="form-label" for="compare-{{ field.name }}">{{ field.label|trans }}</label>
              <select class="form-select" id="compare-{{ field.name }}" name="{{ field.name }}">
                <optgroup label="{{ 'REPOSITORY_REFLIST_BRANCHES'|trans }}">
                  {% for branch in repository.branches %}
                    <option value="{{ branch.name }}"{{ branch.name == field.value ? ' selected' }}>{{ branch.name }}</option>
                  {% endfor %}
                </optgroup>
                <optgroup label="{{ 'REPOSITORY_REFLIST_TAGS'|trans }}">
                  {% for tag in repository.tags %}
                    <option value="{{ tag.name }}"{{ tag.name == field.value ? ' selected' }}>{{ tag.name }}</option>
                  {% endfor %}
                </optgroup>
              </select>
            </div>
            {% if loop.first %}
              <div class="col-auto">
                <a href="{{ path('repository_compare', { repository: repository.name, base: head, head: base }) }}" class="btn btn-secondary" title="{{ 'REPOSITORY_COMPARE_SWAP'|trans }}">&harr;</a>
              </div>
            {% endif %}
          {% endfor %}
          <div class="col-12 col-md-auto">
            <button type="submit" class="btn btn-primary w-100"><svg class="icon"><use href="#i-git-compare"/></svg> {{ 'REPOSITORY_COMPARE_TITLE'|trans }}</button>
          </div>
        </div>
      </div>
      <div class="card-footer compare-summary">
        <span class="badge text-bg-success">{{ 'REPOSITORY_COMPARE_AHEAD'|trans({ '%count%': ahead }) }}</span>
        <span class="badge text-bg-danger">{{ 'REPOSITORY_COMPARE_BEHIND'|trans({ '%count%': behind }) }}</span>
        {% if mergeBase %}
          <span class="ms-2">
            {{ 'REPOSITORY_COMPARE_MERGE_BASE'|trans }}
            <a href="{{ path('commit_show', { repository: repository.name, commitish: mergeBase.hash }) }}">{{ mergeBase.shortHash }}</a>
            {{ mergeBase.subject }}
          </span>
        {% endif %}
      </div>
    </form>
  </div>
</div>

{% if not mergeBase %}
  <div class="alert alert-warning">{{ 'REPOSITORY_COMPARE_UNRELATED'|trans({ '%base%': base, '%head%': head }) }}</div>
{% endif %}

{% if ahead == 0 and behind == 0 %}
  <div class="alert alert-info">{{ 'REPOSITORY_COMPARE_IDENTICAL'|trans({ '%base%': base, '%head%': head }) }}</div>
{% else %}
  {% for section in [{ id: 'ahead', commits: aheadCommits, count: ahead, ref: head, other: base }, { id: 'behind', commits: behindCommits, count: behind, ref: base, other: head }] %}
    {% if section.count > 0 %}
      <div class="row module-row compare-{{ section.id }}">
        <div class="col-12">
          <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
              {{ 'REPOSITORY_COMPARE_ONLY_IN'|trans({ '%ref%': section.ref, '%other%': section.other }) }}
              <span class="badge text-bg-secondary rounded-pill">{{ section.count }}</span>
            </div>
            <div class="card-body p-0">
              {% include 'Commit/list-items.html.twig' with { repository: repository, commits: section.commits } %}
            </div>
            {% if section.count > limit %}
              <div class="card-footer">{{ 'REPOSITORY_COMPARE_TRUNCATED'|trans({ '%limit%': limit, '%count%': section.count }) }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}

  {% if diffs %}
    {% include 'Commit/diff.html.twig' with { repository: repository, files: diffs, newRef: head, newLabel: head, oldRef: mergeBase.hash, oldLabel: mergeBase.shortHash } %}
  {% endif %}
{% endif %}
{% endblock %}
