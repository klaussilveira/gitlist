{% extends 'base.html.twig' %}

{% block header %}
  {% include 'page-header.html.twig' with { repository: repository, baseRef: repository.defaultBranch, current: 'branches' } %}
{% endblock %}

{% block search %}
  {% include 'search.html.twig' with { repository: repository, commitish: repository.defaultBranch } %}
{% endblock %}

{% block body %}
<div class="row module-row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        {{ 'REPOSITORY_BRANCH_TITLE'|trans }}
      </div>
      <div class="card-body">
        <ul class="list-group list-group-flush">
          {% for branch in branches %}
            <li class="list-group-item">
              <h5>
                <svg class="icon"><use href="#i-git-branch"/></svg>
                <a href="{{ path('repository_tree', {repository: repository.name, commitish: branch.name }) }}" title="{{ branch.name }}">
                  {{ branch.name }}
                </a>
              </h5>
              <p>
                <svg class="icon"><use href="#i-git-commit"/></svg>
                <a href="{{ path('commit_show', { repository: repository.name, commitish: branch.target.hash }) }}">{{ branch.target.shortHash }}</a>
                {{ branch.target.subject }}
                <span class="badge text-bg-secondary">
                  {{ branch.target.authoredAt|date(commit_list_date_format) }}
                </span>
              </p>
              {% set comparison = comparisons[branch.name] ?? null %}
              {% if comparison %}
                <p class="branch-comparison">
                  <a href="{{ path('repository_compare', { repository: repository.name, base: defaultBranch, head: branch.name }) }}" class="badge text-bg-success">{{ 'REPOSITORY_COMPARE_AHEAD_OF'|trans({ '%count%': comparison.ahead, '%ref%': defaultBranch }) }}</a>
                  <a href="{{ path('repository_compare', { repository: repository.name, base: branch.name, head: defaultBranch }) }}" class="badge text-bg-danger">{{ 'REPOSITORY_COMPARE_BEHIND_OF'|trans({ '%count%': comparison.behind, '%ref%': defaultBranch }) }}</a>
                  {% if comparison.forkPoint %}
                    {{ 'REPOSITORY_BRANCH_FORKED_FROM'|trans({ '%ref%': defaultBranch }) }}
                    <a href="{{ path('commit_show', { repository: repository.name, commitish: comparison.forkPoint.hash }) }}">{{ comparison.forkPoint.shortHash }}</a>
                  {% endif %}
                  {% if comparison.parent %}
                    <span class="branch-parent" title="{{ 'REPOSITORY_BRANCH_BASED_ON_HINT'|trans }}">
                      {{ 'REPOSITORY_BRANCH_BASED_ON'|trans }}
                      <a href="{{ path('repository_compare', { repository: repository.name, base: comparison.parent, head: branch.name }) }}">{{ comparison.parent }}</a>
                    </span>
                  {% endif %}
                </p>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</div>
{% endblock %}
