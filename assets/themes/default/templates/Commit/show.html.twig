{% extends 'base.html.twig' %}

{% block title %}
  {{ commit.subject }} ({{ commit.shortHash }}) - {{ repository.name }}
{% endblock %}

{% block header %}
  {% include 'page-header.html.twig' with { repository: repository, baseRef: commit.hash, current: 'commits' } %}
{% endblock %}

{% block search %}
  {% include 'search.html.twig' with { repository: repository, commitish: commit.hash } %}
{% endblock %}

{% block body %}
  <div class="row module-row">
    <div class="col-12">
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          {{ commit.subject }}

          <div class="btn-group" role="group">
            {% if commit.firstParent.hash %}
              <a href="{{ path('commit_show', { repository: repository.name, commitish: commit.firstParent.hash }) }}" class="btn btn-secondary">
                <svg class="icon"><use href="#i-git-commit"/></svg> {{ 'REPOSITORY_COMMIT_PARENT'|trans }} {{ commit.firstParent.shortHash }}
              </a>
            {% endif %}
          </div>
        </div>
        <div class="card-body">
          <div class="d-flex justify-content-start align-items-center">
            <img src="{{ getAvatar(commit.author.email, 48) }}" class="rounded me-2" alt="{{ commit.author.name }}" />
            <p class="card-text">
              <a href="mailto:{{ commit.author.email }}" title="{{ commit.author.name }}">{{ commit.author.name }}</a> {{ 'REPOSITORY_COMMIT_COMMITED_ON'|trans }} {{ commit.commitedAt|date(commit_list_date_format) }}<br />
              {{ 'REPOSITORY_COMMIT_CHANGE_STATS'|trans({'%changed%': commit.diffs|length, '%additions%': commit.additions,'%deletions%': commit.deletions}) }}
            </p>
          </div>
          {% if commit.body %}
            <hr />
            <pre>{{ commit.body }}</pre>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {% if notes %}
    <div class="row module-row">
      <div class="col-12">
        <div class="card" id="commit-notes">
          <div class="card-header">
            {{ 'REPOSITORY_COMMIT_NOTES'|trans }}
          </div>
          <ul class="list-group list-group-flush">
            {% for reference, note in notes %}
              <li class="list-group-item">
                <span class="badge text-bg-secondary">{{ reference }}</span>
                <pre class="mb-0 mt-2">{{ note }}</pre>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  {% endif %}

  {% include 'Commit/diff.html.twig' with { repository: repository, files: commit.diffs, newRef: commit.hash, newLabel: commit.shortHash, oldRef: commit.firstParent.hash ?? null, oldLabel: commit.firstParent.shortHash ?? null } %}
{% endblock %}
