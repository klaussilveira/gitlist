{% import 'macros.html.twig' as ui %}
<form class="my-2 my-md-0 flex-grow-1 flex-md-grow-0 order-first order-md-last ms-md-auto" action="{{ path('repository_search_commits_action', {repository: repository.name, commitish: commitish}) }}" method="post" autocomplete="off" role="search">
  <div class="input-icon">
    <span class="input-icon-addon">{{ ui.icon('search') }}</span>
    <input type="search" name="query" class="form-control" placeholder="{{ 'REPOSITORY_MENU_SEARCH_PLACEHOLDER'|trans }}" aria-label="{{ 'REPOSITORY_MENU_SEARCH_PLACEHOLDER'|trans }}">
  </div>
</form>
