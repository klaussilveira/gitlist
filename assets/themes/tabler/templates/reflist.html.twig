{% import 'macros.html.twig' as ui %}
<div class="dropdown">
  <a class="btn dropdown-toggle mw-100" role="button" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
    {{ ui.icon('git-branch') }}
    <span class="text-secondary me-1">{{ 'REPOSITORY_REFLIST_TOGGLE'|trans }}</span>
    <strong class="text-truncate">{{ ref }}</strong>
  </a>
  <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-card ref-list">
    <div class="card">
      <div class="card-body p-2">
        <div class="input-icon">
          <span class="input-icon-addon">{{ ui.icon('search') }}</span>
          <input type="text" list="refs" class="form-control" placeholder="{{ 'REPOSITORY_REFLIST_PLACEHOLDER'|trans }}" aria-label="{{ 'REPOSITORY_REFLIST_PLACEHOLDER'|trans }}">
        </div>
        <datalist id="refs">
          {% for branch in repository.branches %}
            <option value="{{ branch.name }}" data-target="{{ path(path, {repository: repository.name, commitish: getCommitish(branch.name, refPath) }) }}">
          {% endfor %}
          {% for tag in repository.tags %}
            <option value="{{ tag.name }}" data-target="{{ path(path, {repository: repository.name, commitish: getCommitish(tag.name, refPath) }) }}">
          {% endfor %}
        </datalist>

        <nav class="nav nav-segmented nav-sm w-100 mt-2" id="reflist" role="tablist">
          <button class="nav-link active" id="branches-tab" data-bs-toggle="tab" data-bs-target="#branches" type="button" role="tab" aria-controls="branches" aria-selected="true">
            {{ ui.icon('git-branch', 'nav-link-icon') }} {{ 'REPOSITORY_REFLIST_BRANCHES'|trans }}
            <span class="badge ms-1">{{ repository.branches|length }}</span>
          </button>
          <button class="nav-link" id="tags-tab" data-bs-toggle="tab" data-bs-target="#tags" type="button" role="tab" aria-controls="tags" aria-selected="false">
            {{ ui.icon('tag', 'nav-link-icon') }} {{ 'REPOSITORY_REFLIST_TAGS'|trans }}
            <span class="badge ms-1">{{ repository.tags|length }}</span>
          </button>
        </nav>
      </div>

      <div class="tab-content">
        <div class="tab-pane active" id="branches" role="tabpanel" aria-labelledby="branches-tab">
          <div class="list-group list-group-flush list-group-hoverable">
            {% for branch in repository.branches %}
              <a class="list-group-item list-group-item-action text-truncate{{ branch.name == ref ? ' active' }}" href="{{ path(path, {repository: repository.name, commitish: getCommitish(branch.name, refPath) }) }}" title="{{ branch.name }}">{{ branch.name }}</a>
            {% endfor %}
          </div>
        </div>
        <div class="tab-pane" id="tags" role="tabpanel" aria-labelledby="tags-tab">
          <div class="list-group list-group-flush list-group-hoverable">
            {% for tag in repository.tags %}
              <a class="list-group-item list-group-item-action text-truncate{{ tag.name == ref ? ' active' }}" href="{{ path(path, {repository: repository.name, commitish: getCommitish(tag.name, refPath) }) }}" title="{{ tag.name }}">{{ tag.name }}</a>
            {% else %}
              <div class="list-group-item text-secondary">{{ 'REPOSITORY_TAGS_NO_TAGS_AVAILABLE'|trans }}</div>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
